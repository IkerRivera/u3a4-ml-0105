print("\n19. RESUMEN POR DIFICULTAD DE PREPARACIÓN:")

resumen = df.groupby('dificultad_preparacion').agg(
    planes=('id_plan', 'count'),
    calorias_promedio=('calorias_diarias', 'mean'),
    proteinas_promedio=('proteinas_gramos', 'mean'),
    costo_promedio=('costo_semanal_estimado', 'mean')
)

print(resumen)

# 20. Gráfica de barras: Planes por dificultad
conteo = df['dificultad_preparacion'].value_counts()

plt.figure(figsize=(8, 5))
plt.bar(conteo.index, conteo.values, color='skyblue')
plt.title('Cantidad de planes por dificultad de preparación')
plt.xlabel('Dificultad de preparación')
plt.ylabel('Cantidad de planes')
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.show()

# 21. Gráfica de barras: Calorías por plan
plt.figure(figsize=(8, 5))
plt.bar(df['nombre_plan'], df['calorias_diarias'], color='lightgreen')
plt.title('Calorías diarias por plan nutricional')
plt.xlabel('Nombre del plan')
plt.ylabel('Calorías diarias')
plt.xticks(rotation=30)
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.show()

# 22. Histograma: Distribución de proteínas
plt.figure(figsize=(8, 5))
plt.hist(df['proteinas_gramos'], bins=5, color='orange', edgecolor='black')
plt.title('Distribución de proteínas en los planes nutricionales')
plt.xlabel('Proteínas en gramos')
plt.ylabel('Frecuencia')
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.show()

# 23. Gráfica de dispersión: Calorías vs costo
plt.figure(figsize=(8, 5))
plt.scatter(
    df['calorias_diarias'],
    df['costo_semanal_estimado'],
    color='red',
    s=100
)
plt.title('Relación entre calorías diarias y costo semanal')
plt.xlabel('Calorías diarias')
plt.ylabel('Costo semanal en pesos')
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.show()

# 24. Diagrama de caja: Distribución de costos
plt.figure(figsize=(7, 5))
plt.boxplot(
    df['costo_semanal_estimado'],
    patch_artist=True,
    boxprops=dict(facecolor='lightblue')
)
plt.title('Distribución de costos semanales de los planes')
plt.ylabel('Costo semanal en pesos')
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.show()

# 25. Matriz de correlación
correlacion = df.corr(numeric_only=True)

print("\n--- MATRIZ DE CORRELACIÓN ---")
print(correlacion)

plt.figure(figsize=(9, 6))
plt.imshow(correlacion, cmap='coolwarm', vmin=-1, vmax=1)
plt.colorbar()

plt.xticks(
    range(len(correlacion.columns)),
    correlacion.columns,
    rotation=45
)

plt.yticks(
    range(len(correlacion.columns)),
    correlacion.columns
)

plt.title('Matriz de correlación de variables numéricas')
plt.tight_layout()
plt.show()
